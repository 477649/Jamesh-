import json
from pathlib import Path

DATA_DIR = Path("docs/data")

files = []
for csv in sorted(DATA_DIR.glob("floorsheet_*.csv")):
    date = csv.stem.replace("floorsheet_", "")
    files.append({
        "date": date,
        "file": f"data/{csv.name}"
    })

index = {
    "files": files,
    "latest": files[-1]["date"] if files else None
}

with open(DATA_DIR / "index.json", "w", encoding="utf-8") as f:
    json.dump(index, f, indent=2)
